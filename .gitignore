# Project-wide gitignore

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Build outputs
/target/
/build/
/dist/
/out/

# Dependency directories
/node_modules/
/frontend/node_modules/
/backend/target/

# Environment files
.env
.env.local
.env.*.local
/backend/.env
/frontend/.env
/frontend/.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
/coverage/
/frontend/coverage/
/backend/target/site/jacoco/

# Database
*.sqlite
*.db
*.sql

# Temporary files
*.tmp
*.temp
.tmp/
temp/

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Maven
/backend/target/
/backend/*.jar
/backend/*.war
/backend/.mvn/wrapper/maven-wrapper.jar

# Vite
/frontend/dist/
/frontend/.vite/

# TypeScript
*.tsbuildinfo

# Package manager locks (optional - keep for reproducibility)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml